{
  "name": "rpgcards-les-quatre-voies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Les Quatre Voies — RPG de cartes : moteur de duel V3.0 + delta V3.2, plateau manipulable, art procédural par code (Three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:browser": "node tools/qa-browser.mjs",
    "shots": "node tools/shots.mjs",
    "perf": "node tools/perf.mjs",
    "sim": "tsx tools/perf-engine.ts 200"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
