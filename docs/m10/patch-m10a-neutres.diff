diff --git a/test/neutres.test.ts b/test/neutres.test.ts
new file mode 100644
index 0000000..40da18c
--- /dev/null
+++ b/test/neutres.test.ts
@@ -0,0 +1,63 @@
+/**
+ * Avenant M10-A (PROPOSÉ, non ratifié) — cartes neutres dans le moteur : composition (ADR 030), aucune affinité, deck
+ * sans Signature jouable jusqu'au bout, et mode standard inchangé (les autres tests du dépôt passent sans modification).
+ */
+import { describe, expect, it } from 'vitest';
+import { cardDef } from '../src/game/catalog/cards';
+import { damageCoefficient, rankSupport } from '../src/game/engine/clash';
+import { createGame } from '../src/game/engine/engine';
+import { autoplay } from '../src/game/match';
+import type { GameConfig } from '../src/game/model/types';
+import { viewFor } from '../src/game/visibility/view';
+
+const N16 = [1, 2, 3, 4].flatMap((r) => Array.from({ length: 4 }, () => `neutre-${r}`));
+const seat = (deck: string[], signature: GameConfig['players']['p1']['signature'] = null, hp = 60): GameConfig['players']['p1'] =>
+  ({ name: 'x', hp, signature, variants: [], techniques: ['Sondage', 'Recentrage'], deck });
+
+describe('M10-A — neutres dans le moteur (proposé)', () => {
+  it('16 instances, 4 par Rang, identifiants distincts, sans famille ni effet', () => {
+    const { state } = createGame({ seed: 1, players: { p1: seat(N16), p2: seat(N16) } });
+    const p1 = Object.values(state.cards).filter((c) => c.owner === 'p1');
+    expect(p1).toHaveLength(16);
+    expect(new Set(p1.map((c) => c.id)).size).toBe(16);
+    for (const r of [1, 2, 3, 4]) expect(p1.filter((c) => c.defId === `neutre-${r}`)).toHaveLength(4);
+    for (const c of p1) { const d = cardDef(c.defId); expect(d.family).toBeNull(); expect(d.effect).toBeNull(); expect(d.power).toBe(3 * d.rank!); }
+  });
+
+  it('aucune affinité : neutre + neutre, neutre + Basic, Basic + neutre ; Basic + Basic de même famille : +1 (inchangé)', () => {
+    const n2 = cardDef('neutre-2'); const n4 = cardDef('neutre-4'); const c2 = cardDef('Cendre-2-basic'); const c4 = cardDef('Cendre-4-basic');
+    expect(rankSupport(n2, n4)).toBe(2);
+    expect(rankSupport(n2, c4)).toBe(2);
+    expect(rankSupport(c2, n4)).toBe(2);
+    expect(rankSupport(c2, c4)).toBe(3);
+    expect(damageCoefficient(n2, n4)).toBe(2);
+    expect(damageCoefficient(c2, n4)).toBe(2);
+    expect(damageCoefficient(c2, c4)).toBe(3);
+    // Prisme et Convergence gardent leur texte : une Primaire neutre est « d'une autre famille » (à arbitrer, A-2)
+    expect(damageCoefficient(cardDef('Astre-2-prisme'), n4)).toBe(3);
+    expect(damageCoefficient(cardDef('Astre-4-convergence'), n4)).toBe(6);
+  });
+
+  it('deck sans Signature : 300 duels IA contre IA terminés, sans exception, sans ∞', () => {
+    for (let s = 1; s <= 300; s++) {
+      const m = autoplay({ seed: s, players: { p1: seat(N16), p2: seat(N16) } });
+      expect(m.state.phase).toBe('ENDED');
+      expect(m.events.some((e) => e.kind === 'clash' && Object.values((e.data as { scores: Record<string, unknown> }).scores).includes('inf'))).toBe(false);
+    }
+  }, 180000);
+
+  it('vue adverse : main et Secondaires cachées du joueur invisibles ; famille publique « null » pour une neutre', () => {
+    const m = autoplay({ seed: 7, players: { p1: seat(N16), p2: seat(N16) } }, 3);
+    const v = viewFor(m.state, 'p2');
+    expect(v.opp.hand).toBeNull();
+    for (const s of v.opp.slots) if (s && s.state === 'hidden') expect(s.card).toBeNull();
+    expect(v.opp.slots.every((s) => !s || s.family === null)).toBe(true);
+  });
+
+  it('mixte : 12 neutres + 4 Basics, et adversaire à Signature (chef) : jouable', () => {
+    const deck = ['Voile-1-basic', 'Voile-2-basic', 'Voile-3-basic', 'Voile-4-basic', ...N16.filter((_, i) => i % 4 !== 0)];
+    const chef = ['Ronce-1-racine', 'Ronce-2-ecaille', 'Ronce-3-entrave', 'Ronce-4-tenacite', ...N16.filter((_, i) => i % 4 !== 0), 'sig-Ronce'];
+    const m = autoplay({ seed: 3, players: { p1: seat(deck, null, 90), p2: { ...seat(chef, 'Ronce', 110), techniques: ['Ancrage', 'Rupture'] } } });
+    expect(m.state.phase).toBe('ENDED');
+  });
+});
diff --git a/tools/m10a-sim.ts b/tools/m10a-sim.ts
new file mode 100644
index 0000000..0936566
--- /dev/null
+++ b/tools/m10a-sim.ts
@@ -0,0 +1,41 @@
+// Avenant M10-A (PROPOSÉ) — simulation d'équilibrage IA contre IA sur le moteur patché (neutres, deck explicite,
+// Signature optionnelle). Usage : npx tsx tools/m10a-sim.ts [duels par matchup]
+import { autoplay } from '../src/game/match';
+import { PROFILES } from '../src/game/ai/policy';
+import type { GameConfig } from '../src/game/model/types';
+import type { TechniqueId } from '../src/game/catalog/techniques';
+
+const N = Number(process.argv[2] ?? 400);
+const N16 = [1, 2, 3, 4].flatMap((r) => Array.from({ length: 4 }, () => `neutre-${r}`));
+const sansUnParRang = (k: number) => [1, 2, 3, 4].flatMap((r) => Array.from({ length: 4 - k }, () => `neutre-${r}`));
+const fam = (f: string, v: Record<number, string | null>) => [1, 2, 3, 4].map((r) => (v[r] ? `${f}-${r}-${v[r]}` : `${f}-${r}-basic`));
+type Seat = GameConfig['players']['p1'];
+const seat = (deck: string[] | null, hp: number, techniques: TechniqueId[], signature: Seat['signature'] = null, variants: Seat['variants'] = []): Seat =>
+  ({ name: 'x', hp, signature, variants, techniques, ...(deck ? { deck } : {}) });
+const RUE: TechniqueId[] = ['Sondage', 'Recentrage'];
+
+const M: Array<{ id: string; p1: Seat; p2: Seat; prof: [string, string] }> = [
+  { id: 'Inaugural : 16 neutres contre 16 neutres, PV 60/60', p1: seat(N16, 60, RUE), p2: seat(N16, 60, RUE), prof: ['equilibre', 'offensif'] },
+  { id: 'Inaugural (miroir de profil équilibré)', p1: seat(N16, 60, RUE), p2: seat(N16, 60, RUE), prof: ['equilibre', 'equilibre'] },
+  { id: 'Cadet Voile : joueur 12 N + 4 Basics Voile (PV 90) contre cadet 12 N + Voile dont III Dissimulation (PV 80)', p1: seat([...fam('Voile', {}), ...sansUnParRang(1)], 90, ['Sondage', 'Dissipation']), p2: seat([...fam('Voile', { 3: 'dissimulation' }), ...sansUnParRang(1)], 80, ['Lecture', 'Dissipation']), prof: ['equilibre', 'lecteur'] },
+  { id: 'Bras droit Voile : joueur 12 N + Voile (III) contre Sélène 12 N + Voile (III, IV) (PV 100)', p1: seat([...fam('Voile', { 3: 'dissimulation' }), ...sansUnParRang(1)], 90, ['Sondage', 'Dissipation']), p2: seat([...fam('Voile', { 3: 'dissimulation', 4: 'silence' }), ...sansUnParRang(1)], 100, ['Lecture', 'Dissipation']), prof: ['equilibre', 'lecteur'] },
+  { id: 'Chef Voile : joueur 12 N + Voile (III, IV), sans Signature, contre Ilse 12 N + 4 variantes + Miroir du Voile (PV 110)', p1: seat([...fam('Voile', { 3: 'dissimulation', 4: 'silence' }), ...sansUnParRang(1)], 90, ['Sondage', 'Dissipation']), p2: seat([...fam('Voile', { 1: 'eclaireur', 2: 'detour', 3: 'dissimulation', 4: 'silence' }), ...sansUnParRang(1), 'sig-Voile'], 110, ['Lecture', 'Dissipation'], 'Voile'), prof: ['equilibre', 'lecteur'] },
+  { id: 'Chef Voile, PV 90 (variante d’équilibrage)', p1: seat([...fam('Voile', { 3: 'dissimulation', 4: 'silence' }), ...sansUnParRang(1)], 90, ['Sondage', 'Dissipation']), p2: seat([...fam('Voile', { 1: 'eclaireur', 2: 'detour', 3: 'dissimulation', 4: 'silence' }), ...sansUnParRang(1), 'sig-Voile'], 90, ['Lecture', 'Dissipation'], 'Voile'), prof: ['equilibre', 'lecteur'] },
+  { id: 'Référence standard : 17 cartes, toutes variantes, PV 90/90', p1: seat(null, 90, ['Lecture', 'Ancrage'], 'Cendre', 'all'), p2: seat(null, 90, ['Sondage', 'Rupture'], 'Ronce', 'all'), prof: ['equilibre', 'offensif'] },
+];
+
+const med = (xs: number[]) => { const s = [...xs].sort((a, b) => a - b); return s[Math.floor(s.length / 2)]!; };
+console.log(`| Matchup | Duels | Victoires p1 | Tours (moyenne / médiane) | Prolongations |`);
+console.log(`|---|---:|---:|---:|---:|`);
+for (const m of M) {
+  let w = 0; const turns: number[] = []; let ot = 0;
+  for (let s = 1; s <= N; s++) {
+    const cfg: GameConfig = { seed: 1000 + s, players: { p1: { ...m.p1, name: 'p1' }, p2: { ...m.p2, name: 'p2' } } };
+    const r = autoplay(cfg, 200, [PROFILES[m.prof[0]]!, PROFILES[m.prof[1]]!]);
+    if (r.state.winner === 'p1') w++;
+    turns.push(r.state.turn);
+    if (r.state.overtime > 0) ot++;
+  }
+  const mean = turns.reduce((a, b) => a + b, 0) / turns.length;
+  console.log(`| ${m.id} (IA ${m.prof.join(' / ')}) | ${N} | ${(100 * w / N).toFixed(1)} % | ${mean.toFixed(1)} / ${med(turns)} | ${(100 * ot / N).toFixed(1)} % |`);
+}
